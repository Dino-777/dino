<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>나의 고등학교 3년 포트폴리오</title>
    <style>
        /* 🎨 전체 페이지 꾸미기 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: '맑은 고딕', 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        /* 📦 전체 컨테이너 */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        /* 🎭 헤더 부분 */
        header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }

        header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        /* 📋 메인 콘텐츠 */
        main {
            padding: 40px;
        }

        /* 🏷️ 섹션 제목 */
        h2 {
            color: #667eea;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 3px solid #667eea;
            font-size: 1.8em;
        }

        /* 📝 입력 폼 부분 */
        .form-section {
            background: #f8f9fa;
            padding: 30px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #333;
        }

        input[type="text"],
        input[type="date"],
        textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 1em;
            font-family: inherit;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus,
        input[type="date"]:focus,
        textarea:focus {
            outline: none;
            border-color: #667eea;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        /* 🔘 버튼 스타일 */
        button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1em;
            font-weight: bold;
            transition: transform 0.2s, box-shadow 0.2s;
            margin-right: 10px;
            margin-bottom: 10px;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        button:active {
            transform: translateY(0);
        }

        /* 📤 파일 업로드 */
        .file-input-wrapper {
            position: relative;
            display: inline-block;
        }

        input[type="file"] {
            display: none;
        }

        .file-label {
            background: #28a745;
            color: white;
            padding: 12px 30px;
            border-radius: 8px;
            cursor: pointer;
            display: inline-block;
            transition: all 0.3s;
        }

        .file-label:hover {
            background: #218838;
            transform: translateY(-2px);
        }

        /* 📸 포트폴리오 항목 표시 */
        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .portfolio-item {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s, box-shadow 0.3s;
            position: relative;
        }

        .portfolio-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.2);
        }

        .portfolio-item h3 {
            color: #667eea;
            margin-bottom: 10px;
            font-size: 1.3em;
        }

        .portfolio-item p {
            color: #666;
            margin-bottom: 8px;
            line-height: 1.6;
        }

        .portfolio-item .meta {
            font-size: 0.9em;
            color: #999;
            margin-bottom: 15px;
        }

        /* 📷 이미지 미리보기 */
        .portfolio-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        /* 🎬 비디오 */
        .portfolio-item video {
            width: 100%;
            height: 200px;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        /* 🔗 링크 스타일 */
        .portfolio-item a {
            display: inline-block;
            color: white;
            background: #667eea;
            padding: 8px 15px;
            border-radius: 5px;
            text-decoration: none;
            margin-right: 10px;
            margin-bottom: 10px;
            transition: all 0.3s;
        }

        .portfolio-item a:hover {
            background: #764ba2;
        }

        /* 🗑️ 삭제 버튼 */
        .delete-btn {
            background: #dc3545 !important;
            padding: 5px 10px !important;
            font-size: 0.8em !important;
            position: absolute;
            top: 10px;
            right: 10px;
        }

        .delete-btn:hover {
            background: #c82333 !important;
        }

        /* 📄 문서 아이콘 */
        .file-icon {
            width: 100%;
            height: 150px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3em;
            margin-bottom: 15px;
        }

        /* 💬 알림 메시지 */
        .message {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
        }

        .message.success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            display: block;
        }

        .message.error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            display: block;
        }

        /* 🏆 월별 섹션 */
        .year-section {
            margin-bottom: 50px;
        }

        .year-header {
            background: #f8f9fa;
            padding: 20px;
            border-left: 5px solid #667eea;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .year-header h3 {
            color: #667eea;
            font-size: 1.4em;
        }

        /* 📱 반응형 디자인 */
        @media (max-width: 768px) {
            main {
                padding: 20px;
            }

            header h1 {
                font-size: 1.8em;
            }

            .portfolio-grid {
                grid-template-columns: 1fr;
            }

            .form-section {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- 🎭 헤더 -->
        <header>
            <h1>🌟 나의 고등학교 3년 포트폴리오</h1>
            <p>꿈과 도전으로 가득 찬 3년의 기록</p>
        </header>

        <!-- 📋 메인 콘텐츠 -->
        <main>
            <!-- 💬 알림 메시지 -->
            <div id="message" class="message"></div>

            <!-- 📝 입력 폼 -->
            <section class="form-section">
                <h2>✏️ 새로운 활동 추가하기</h2>
                
                <form id="portfolioForm">
                    <!-- 제목 입력 -->
                    <div class="form-group">
                        <label for="title">📌 활동 제목</label>
                        <input type="text" id="title" placeholder="예: 과학 발명품 만들기" required>
                    </div>

                    <!-- 날짜 입력 -->
                    <div class="form-group">
                        <label for="date">📅 활동 날짜</label>
                        <input type="date" id="date" required>
                    </div>

                    <!-- 분류 선택 -->
                    <div class="form-group">
                        <label for="category">🏷️ 분류</label>
                        <select id="category" style="width: 100%; padding: 12px; border: 2px solid #ddd; border-radius: 8px; font-size: 1em;">
                            <option value="학교활동">학교활동</option>
                            <option value="대외활동">대외활동</option>
                            <option value="동아리">동아리</option>
                            <option value="수상">수상</option>
                            <option value="자격증">자격증</option>
                            <option value="프로젝트">프로젝트</option>
                            <option value="봉사">봉사</option>
                            <option value="기타">기타</option>
                        </select>
                    </div>

                    <!-- 설명 입력 -->
                    <div class="form-group">
                        <label for="description">📝 활동 설명</label>
                        <textarea id="description" placeholder="어떤 활동이었고, 무엇을 배웠나요?" required></textarea>
                    </div>

                    <!-- 파일 업로드 -->
                    <div class="form-group">
                        <label>📤 파일 업로드 (선택사항)</label>
                        <p style="font-size: 0.9em; color: #666; margin-bottom: 10px;">
                            💡 이미지, 영상, 문서, 링크 모두 추가할 수 있어요!
                        </p>
                        <div class="file-input-wrapper">
                            <label for="files" class="file-label">📁 파일 선택하기</label>
                            <input type="file" id="files" multiple accept="image/*,video/*,.pdf,.doc,.docx,.ppt,.pptx,text/plain">
                        </div>
                        <div id="fileList" style="margin-top: 10px;"></div>
                    </div>

                    <!-- 링크 추가 -->
                    <div class="form-group">
                        <label for="link">🔗 관련 링크 (선택사항)</label>
                        <input type="text" id="link" placeholder="https://example.com">
                    </div>

                    <!-- 제출 버튼 -->
                    <button type="submit">✨ 포트폴리오에 추가하기</button>
                </form>
            </section>

            <!-- 🎨 포트폴리오 표시 -->
            <section>
                <h2>🎬 내 포트폴리오</h2>
                <div id="portfolioContainer" class="portfolio-grid"></div>
                <div id="emptyMessage" style="text-align: center; color: #999; padding: 40px;">
                    💭 아직 추가된 활동이 없어요. 위에서 첫 번째 활동을 추가해보세요!
                </div>
            </section>
        </main>
    </div>

